# SQLite is the default for local clone-and-run (no Postgres required).
# DATABASE_URL=sqlite:///./okfbench.db

# Free Render Postgres example:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# Optional LLM: Groq is the primary live provider (free tier available).
# Without either key, or when LLM_STUB=true, deterministic stub answers are used.
GROQ_API_KEY=
# OpenAI is an optional secondary provider, used only when GROQ_API_KEY is absent.
# OPENAI_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Force stub even if a key is set:
# LLM_STUB=true

APP_NAME=OKFBench Chat
TOP_K=5
OKF_HOP_DEPTH=2
CORS_ORIGINS=*
